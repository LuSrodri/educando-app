# ===========================================
# EDUCANDO APP - CONFIGURACAO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores

# -------------------------------------------
# SUPABASE - Banco de dados e Storage
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# -------------------------------------------
# OPENAI - Classificacao de metadados, limpeza de imagens, busca externa (Fase 6)
# -------------------------------------------
# Chave da API da OpenAI, usada pelo backfill, pelo classificador GPT-5.4 nano e
# pela limpeza de imagens via gpt-image-2 (images.edit).
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# -------------------------------------------
# TAVILY - Busca de materiais externos (Fase 6)
# -------------------------------------------
# Obtenha em: https://tavily.com/
TAVILY_API_KEY=tvly-...

# -------------------------------------------
# CLOUDFLARE TURNSTILE - Anti-bot (Fase 7)
# -------------------------------------------
# Obtenha em: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x...
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x...

# -------------------------------------------
# APLICACAO
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# FIRECRAWL - Scraping tecnico para o gerador semanal
# -------------------------------------------
# Obtenha em: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# -------------------------------------------
# CRON SECRET - Protecao do endpoint do cron job
# -------------------------------------------
# Gere um valor aleatorio seguro, ex: openssl rand -hex 32
# Configure tambem em: Vercel Dashboard > Project > Settings > Environment Variables
CRON_SECRET=seu-segredo-aqui

# -------------------------------------------
# MCP / CLAUDE CODE (opcional - apenas dev tooling)
# -------------------------------------------
# Personal Access Token do Supabase, usado pelo MCP server em .mcp.json
# Nao e necessario para rodar a aplicacao, apenas para integracao com Claude Code
# Crie em: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=seu-pat-supabase-aqui
