# ===========================================
# EDUCANDO APP - CONFIGURACAO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores

# -------------------------------------------
# SUPABASE - Banco de dados e Storage
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# -------------------------------------------
# GOOGLE GEMINI AI - Melhoria de prompt e safety check
# -------------------------------------------
# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# -------------------------------------------
# REPLICATE - Geracao de imagens (seedream-4)
# -------------------------------------------
# Token da API Replicate
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=seu-token-replicate-aqui

# -------------------------------------------
# APLICACAO
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
