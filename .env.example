# ===========================================
# EDUCANDO APP - CONFIGURAÇÃO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores

# -------------------------------------------
# SUPABASE - Banco de dados e Storage
# -------------------------------------------
# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (pública) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Chave de serviço (privada) do Supabase - NÃO EXPOR NO FRONTEND
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# -------------------------------------------
# GOOGLE GEMINI AI - Geração de atividades
# -------------------------------------------
# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# -------------------------------------------
# MERCADO PAGO - Pagamentos PIX
# -------------------------------------------
# Access Token do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Use TEST-... para sandbox ou APP-... para produção
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-token-aqui

# -------------------------------------------
# APLICAÇÃO
# -------------------------------------------
# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
