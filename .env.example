# =============================================================================
# educando.app — variáveis de ambiente
# Copie para .env e preencha os valores reais. Nunca commite o .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — banco de dados, autenticação e storage
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# Personal Access Token — usado pelo MCP do Supabase no Claude Code (dev only)
# Crie em: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=seu-pat-supabase-aqui

# -----------------------------------------------------------------------------
# OpenAI — spec (gpt-5.4-nano) + geração de fichas (gpt-image-2)
# Obtenha em: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Tavily — pesquisa pedagógica pré-geração
# Obtenha em: https://tavily.com/
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-...

# -----------------------------------------------------------------------------
# Firecrawl — scraping de URLs educacionais para enriquecimento
# Obtenha em: https://firecrawl.dev/
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=fc-...

# -----------------------------------------------------------------------------
# Stripe — checkout Pix (conta Atlas / US)
# Obtenha em: https://dashboard.stripe.com/test/apikeys
# Webhook local: `stripe listen --forward-to http://localhost:3000/api/webhooks/stripe`
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — proteção anti-bot no diretório
# Obtenha em: https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x...
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x...

# -----------------------------------------------------------------------------
# Cron secret — protege o endpoint /api/cron/weekly-activities
# Gere com: openssl rand -hex 32
# Configure também em: Vercel Dashboard > Settings > Environment Variables
# -----------------------------------------------------------------------------
CRON_SECRET=seu-segredo-aqui

# -----------------------------------------------------------------------------
# URL base da aplicação
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
