# ===========================================
# EDUCANDO APP - CONFIGURACAO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores

# -------------------------------------------
# SUPABASE - Banco de dados e Storage
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# -------------------------------------------
# GOOGLE GEMINI AI - Melhoria de prompt e safety check
# -------------------------------------------
# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# -------------------------------------------
# MERCADO PAGO - Pagamento PIX
# -------------------------------------------
# Access token de producao (APP_USR-...) ou sandbox (TEST-...)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-sua-chave-aqui

# Segredo do webhook para validacao de assinatura HMAC-SHA256
# Configure em: Mercado Pago > Suas integrações > Webhooks
# URL do webhook: https://seu-dominio.com/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=seu-segredo-webhook-aqui

# -------------------------------------------
# PINTEREST - Auto-postagem de atividades gratuitas
# -------------------------------------------
# Access token OAuth do Pinterest (conta do app)
# Obtenha em: https://developers.pinterest.com/apps/
# Scope necessario: boards:read, pins:write
PINTEREST_ACCESS_TOKEN=seu-token-pinterest-aqui

# ID do quadro (board) para postar os pins
# Exemplo: "123456789" (visível na URL do quadro no Pinterest)
PINTEREST_BOARD_ID=seu-board-id-aqui

# -------------------------------------------
# APLICACAO
# -------------------------------------------
# URL base da aplicacao (sem barra no final)
# Em producao: https://educando.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
